generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ActivityLog {
  id          String    @id @db.Uuid
  userId      String?   @map("user_id") @db.VarChar(36)
  workspaceId String?   @map("workspace_id") @db.VarChar(36)
  entityType  String?   @map("entity_type") @db.VarChar(50)
  entityId    String?   @map("entity_id") @db.VarChar(36)
  action      String?   @db.VarChar(50)
  detail      Json?     @db.JsonB
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("activity_log")
}

model AgentRun {
  id             String    @id @db.VarChar(36)
  taskId         String    @map("task_id") @db.VarChar(36)
  workspaceId    String    @map("workspace_id") @db.VarChar(36)
  conversationId String?   @map("conversation_id") @db.VarChar(36)
  agentType      String    @map("agent_type") @db.VarChar(50)
  status         String?   @default("pending") @db.VarChar(30)
  input          Json?     @db.JsonB
  output         Json?     @db.JsonB
  errorMessage   String?   @map("error_message")
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt     DateTime? @map("finished_at") @db.Timestamptz(6)
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  task           Task      @relation(fields: [taskId], references: [id])

  @@map("agent_run")
}

model Artifact {
  id          String    @id @db.VarChar(36)
  taskId      String    @map("task_id") @db.VarChar(36)
  workspaceId String    @map("workspace_id") @db.VarChar(36)
  type        String    @db.VarChar(50)
  title       String?   @db.VarChar(255)
  content     Json?     @db.JsonB
  version     Int?      @default(1)
  createdAt   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  task        Task      @relation(fields: [taskId], references: [id])

  @@map("artifact")
}

model Conversation {
  id            String    @id @db.VarChar(36)
  workspaceId   String    @map("workspace_id") @db.VarChar(36)
  userId        String    @map("user_id") @db.VarChar(36)
  title         String?   @db.VarChar(255)
  type          String?   @default("chat") @db.VarChar(30)
  status        String?   @default("active") @db.VarChar(20)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User      @relation(fields: [userId], references: [id])
  workspace     Workspace @relation(fields: [workspaceId], references: [id])
  messages      Message[]
  tasks         Task[]

  @@map("conversation")
}

model Message {
  id             String       @id @db.VarChar(36)
  conversationId String       @map("conversation_id") @db.VarChar(36)
  role           String       @db.VarChar(20)
  content        String
  meta           Json?        @db.JsonB
  createdAt      DateTime?    @default(now()) @map("created_at") @db.Timestamptz(6)
  userInput      Json?        @map("user_input") @db.JsonB
  type           String?      @db.VarChar(20)
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  @@map("message")
}

model RequestForm {
  id        String            @id @db.VarChar(36)
  chatId    String            @map("chat_id") @db.VarChar(36)
  version   Int               @default(1)
  status    String            @db.VarChar(32)
  summary   String?
  createdAt DateTime?         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime?         @default(now()) @map("updated_at") @db.Timestamptz(6)
  items     RequestFormItem[]

  @@map("request_form")
}

model RequestFormItem {
  id           String      @id @db.VarChar(36)
  formId       String      @map("form_id") @db.VarChar(36)
  type         String      @db.VarChar(32)
  status       String      @db.VarChar(32)
  agent        String?     @db.VarChar(32)
  priority     Int?        @default(0)
  payload      Json        @db.JsonB
  parentItemId String?     @map("parent_item_id") @db.VarChar(36)
  createdAt    DateTime?   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime?   @default(now()) @map("updated_at") @db.Timestamptz(6)
  requestForm  RequestForm @relation(fields: [formId], references: [id])

  @@map("request_form_item")
}

model TaskExecution {
  id                          String    @id @db.VarChar(36)
  conversationId              String    @map("conversation_id") @db.VarChar(36)
  requestFormId               String?   @map("request_form_id") @db.VarChar(36)
  taskId                      String    @map("task_id") @db.VarChar(64)
  sequence                    Int
  dag                         Json      @db.JsonB
  assignedAgent               String    @map("assigned_agent") @db.VarChar(32)
  title                       String    @db.VarChar(255)
  description                 String
  coveredBusinessModelIndexes Json      @map("covered_business_model_indexes") @db.JsonB
  qualityResult               Json      @map("quality_result") @db.JsonB
  status                      String    @default("planned") @db.VarChar(32)
  createdAt                   DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([conversationId, taskId])
  @@map("task_execution")
}

model Task {
  id             String        @id @db.VarChar(36)
  conversationId String?       @map("conversation_id") @db.VarChar(36)
  workspaceId    String        @map("workspace_id") @db.VarChar(36)
  userId         String        @map("user_id") @db.VarChar(36)
  type           String        @db.VarChar(50)
  status         String?       @default("pending") @db.VarChar(30)
  input          Json?         @db.JsonB
  output         Json?         @db.JsonB
  createdAt      DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime?     @default(now()) @map("updated_at") @db.Timestamptz(6)
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  workspace      Workspace     @relation(fields: [workspaceId], references: [id])
  agentRuns      AgentRun[]
  artifacts      Artifact[]

  @@map("task")
}

model User {
  id            String         @id @db.VarChar(36)
  email         String?        @unique @db.VarChar(255)
  username      String?        @db.VarChar(100)
  avatar        String?
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?      @default(now()) @map("updated_at") @db.Timestamptz(6)
  conversations Conversation[]
  workspaces    Workspace[]

  @@map("user")
}

model Workspace {
  id            String         @id @db.VarChar(36)
  userId        String         @map("user_id") @db.VarChar(36)
  name          String         @db.VarChar(255)
  storageType   String?        @default("local") @map("storage_type") @db.VarChar(20)
  localPath     String?        @map("local_path")
  cloudPath     String?        @map("cloud_path")
  syncStatus    String?        @default("idle") @map("sync_status") @db.VarChar(20)
  createdAt     DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime?      @default(now()) @map("updated_at") @db.Timestamptz(6)
  user          User           @relation(fields: [userId], references: [id])
  conversations Conversation[]
  tasks         Task[]

  @@map("workspace")
}
