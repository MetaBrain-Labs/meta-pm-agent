{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@repo/agent-runtime/*": ["apps/agent-runtime/src/*"],
      "@repo/tools/*": ["packages/tools/src/*"],
      "@repo/agents/*": ["packages/agents/src/*"]
    }
  }
}