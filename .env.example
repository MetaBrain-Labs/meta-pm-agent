# Database
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="meta-pm-agent"
POSTGRES_SCHEMA="public"
POSTGRES_SSL="false"

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_USERNAME=""
REDIS_DB="0"
REDIS_TLS="false"

# LLM (for Conversation Agent)
OPENAI_API_KEY="sk-..."
LLM_ENABLE_THINKING=true
LLM_MODEL="deepseek-chat"
LLM_BASE_URL="https://api.deepseek.com"
LLM_INPUT_PRICE_PER_MILLION=0.025
LLM_CACHE_HIT_INPUT_PRICE_PER_MILLION=3
LLM_OUTPUT_PRICE_PER_MILLION=6

# LANGSMITH
LANGSMITH_API_KEY="lsv2_..."
LANGSMITH_TRACING=false

# Search Engines
TAVILY_API_KEY="tvly-..."

# Agent run summaries (debug/test only)
AGENT_SUMMARY_THINKING_ENABLED=false
AGENT_SUMMARY_TOOL_CALLS_ENABLED=false
AGENT_SUMMARY_CONTEXT_ENABLED=false
AGENT_SUMMARY_OUTPUT_ENABLED=false
AGENT_SUMMARY_OUTPUT_DIR=".agent-summaries"
