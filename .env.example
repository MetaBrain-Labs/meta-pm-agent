# Local preview HTTP boundary (loopback addresses only)
HOST="127.0.0.1"
PORT="3001"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database
POSTGRES_HOST="localhost"
POSTGRES_PORT="5432"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="meta-pm-agent"
POSTGRES_SCHEMA="public"
POSTGRES_SSL="false"

# LLM authentication (model parameters are configured in Model Usage Profiles)
OPENAI_API_KEY="sk-..."
LLM_MODEL="deepseek-flash"
LLM_BASE_URL="https://api.deepseek.com"

# LANGSMITH
LANGSMITH_API_KEY="lsv2_..."
LANGSMITH_TRACING=false

# Search Engines
TAVILY_API_KEY="tvly-..."

# Prompt configuration permissions (trusted server-side source; never client-provided)
# owner: read + write + reset (default for the single-user local deployment)
# editor: read + write | viewer: read only | none: the prompt center stays hidden
PROMPT_CONFIG_ACCESS_ROLE="owner"
# Acting user id for prompt configuration; must match the workspace owner.
PROMPT_CONFIG_USER_ID="local"

# Agent run summaries (debug/test only)
AGENT_SUMMARY_THINKING_ENABLED=false
AGENT_SUMMARY_TOOL_CALLS_ENABLED=false
AGENT_SUMMARY_CONTEXT_ENABLED=false
AGENT_SUMMARY_OUTPUT_ENABLED=false
AGENT_SUMMARY_SUBAGENTS_ENABLED=false
AGENT_SUMMARY_OUTPUT_DIR=".agent-summaries"

# Fatal process crash and abnormal workflow-abort reports (default enabled; set false to disable)
PROCESS_CRASH_REPORT_ENABLED=true
